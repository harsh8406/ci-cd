PORT=5000
MONGO_URI=mongodb://mongo:27017/cicd_platform
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Optional: default Slack/Teams incoming webhook for deployment notifications
# (can be overridden per application via the app's slackWebhookUrl field)
SLACK_WEBHOOK_URL=
# Optional: GitHub Personal Access Token (Contents: read & write) so successful
# deployments auto-commit a status update to the app's README.md on GitHub
GITHUB_TOKEN=
